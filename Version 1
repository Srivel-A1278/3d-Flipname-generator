  const sh=a.length<b.length?'a':'b',df=Math.abs(a.length-b.length);
  w.style.display='block';
  w.innerHTML='Name '+(sh==='a'?1:2)+' is '+df+' letter'+(df>1?'s':'')+' shorter. Add an emoji to fill the gap?<br>'+
    ['❤️','⭐','🌸','🔥'].map(e=>'<button data-e="'+e+'">'+e+'</button>').join('');
  w.querySelectorAll('button').forEach(bt=>bt.onclick=()=>{const f=$(sh);f.value=f.value.trim()+bt.dataset.e;if(check())build()});
  return false;
}
$('a').oninput=$('b').oninput=check;
$('go').onclick=()=>{if(check()&&!build())$('info').textContent='Enter both names first.'};
$('c1').oninput=()=>matL&&matL.color.set($('c1').value);
$('c2').oninput=()=>matP&&matP.color.set($('c2').value);

// ---- orbit viewer ----
let th=0,ph=.4,r=300,tth=0,tph=.4,tr=300,baseR=300,spin=false;
const TAU=Math.PI*2;
function setAz(a){tth=a+Math.round((tth-a)/TAU)*TAU;spin=false}
function resetView(){tth=0;tph=.4;tr=baseR;spin=false}
$('va').onclick=()=>{setAz(0);tph=.3};
$('vb').onclick=()=>{setAz(-Math.PI/2);tph=.3};
$('vt').onclick=()=>{tph=1.45;spin=false};
$('sp').onclick=()=>{spin=!spin};
$('rs').onclick=resetView;stage.ondblclick=resetView;
const pts=new Map();let pd=0;
const dist=()=>{const p=[...pts.values()];return Math.hypot(p[0].x-p[1].x,p[0].y-p[1].y)};
stage.onpointerdown=e=>{pts.set(e.pointerId,{x:e.clientX,y:e.clientY});stage.setPointerCapture(e.pointerId);spin=false;if(pts.size===2)pd=dist()};
stage.onpointerup=stage.onpointercancel=e=>{pts.delete(e.pointerId)};
stage.onpointermove=e=>{
  const p=pts.get(e.pointerId);if(!p)return;const dx=e.clientX-p.x,dy=e.clientY-p.y;p.x=e.clientX;p.y=e.clientY;
  if(pts.size===1){tth-=dx*.008;tph=Math.max(.02,Math.min(1.45,tph+dy*.006))}
  else if(pts.size===2){const d=dist();if(pd)tr=Math.max(baseR*.35,Math.min(baseR*2.5,tr*pd/d));pd=d}
};
stage.addEventListener('wheel',e=>{e.preventDefault();tr=Math.max(baseR*.35,Math.min(baseR*2.5,tr*Math.exp(e.deltaY*.001)))},{passive:false});
(function loop(){
  requestAnimationFrame(loop);
  if(spin)tth+=.01;
  th+=(tth-th)*.15;ph+=(tph-ph)*.15;r+=(tr-r)*.15;
  cam.position.set(r*Math.cos(ph)*Math.sin(th),r*Math.sin(ph),r*Math.cos(ph)*Math.cos(th));
  cam.lookAt(0,0,0);renderer.render(scene,cam);
})();

// ---- STL export ----
function tri(part){
  const T=[];
  if(part!=='P'){const {pos,idx}=S.L;for(let i=0;i<idx.length;i++){const p=3*idx[i];T.push(pos[p],pos[p+1],pos[p+2])}}
  if(part!=='L')for(let i=0;i<S.P.length;i++)T.push(S.P[i]);
  return T;
}
function stlOf(T){
  const nt=T.length/9,buf=new ArrayBuffer(84+50*nt),dv=new DataView(buf),s=S.s;
  new TextEncoder().encodeInto('flip name',new Uint8Array(buf,0,80));dv.setUint32(80,nt,true);
  let o=84;const V=i=>[T[i]*s,-T[i+2]*s,T[i+1]*s];
  for(let t=0;t<nt;t++){
    const p=V(9*t),q=V(9*t+3),w=V(9*t+6);let n=cross(sub(q,p),sub(w,p));const l=Math.hypot(...n)||1;n=n.map(v=>v/l);
    [n,p,q,w].forEach(v=>v.forEach(f=>{dv.setFloat32(o,f,true);o+=4}));o+=2;
  }
  return new Uint8Array(buf);
}
const stlBytes=()=>stlOf(tri('all'));
function objText(){
  const s=S.s,f=v=>(v*s).toFixed(3),V=(x,y,z)=>'v '+f(x)+' '+f(-z)+' '+f(y),{pos,idx}=S.L,P=S.P,o=['# Flip Name 3D, units: mm, z up','o letters'];
  for(let i=0;i<pos.length;i+=3)o.push(V(pos[i],pos[i+1],pos[i+2]));
  for(let i=0;i<idx.length;i+=3)o.push('f '+(idx[i]+1)+' '+(idx[i+1]+1)+' '+(idx[i+2]+1));
  const off=pos.length/3;o.push('o base');
  for(let i=0;i<P.length;i+=3)o.push(V(P[i],P[i+1],P[i+2]));
  for(let i=0;i<P.length/3;i+=3)o.push('f '+(off+i+1)+' '+(off+i+2)+' '+(off+i+3));
  return o.join('\n');
}
function crc32(u){let c=-1;for(let i=0;i<u.length;i++){c^=u[i];for(let k=0;k<8;k++)c=(c>>>1)^(0xEDB88320&-(c&1))}return(c^-1)>>>0}
function zipMany(files){
  const te=new TextEncoder(),parts=[],cds=[];let off=0,cdSize=0;
  for(const f of files){
    const nb=te.encode(f.name),crc=crc32(f.data),sz=f.data.length,lh=new DataView(new ArrayBuffer(30)),ch=new DataView(new ArrayBuffer(46));
    lh.setUint32(0,0x04034b50,true);lh.setUint16(4,20,true);lh.setUint16(12,33,true);lh.setUint32(14,crc,true);lh.setUint32(18,sz,true);lh.setUint32(22,sz,true);lh.setUint16(26,nb.length,true);
    ch.setUint32(0,0x02014b50,true);ch.setUint16(4,20,true);ch.setUint16(6,20,true);ch.setUint16(14,33,true);ch.setUint32(16,crc,true);ch.setUint32(20,sz,true);ch.setUint32(24,sz,true);ch.setUint16(28,nb.length,true);ch.setUint32(42,off,true);
    parts.push(lh,nb,f.data);cds.push(ch,nb);off+=30+nb.length+sz;cdSize+=46+nb.length;
  }
  const ed=new DataView(new ArrayBuffer(22));
  ed.setUint32(0,0x06054b50,true);ed.setUint16(8,files.length,true);ed.setUint16(10,files.length,true);ed.setUint32(12,cdSize,true);ed.setUint32(16,off,true);
  return new Blob([...parts,...cds,ed],{type:'application/zip'});
}
// Inside claude.ai the page saves .zip files (the viewer only allows certain file types); opened as a normal file, the STL saves directly.
const framed=!!window.claude;let dls=null;
if(framed)claude.use('downloads').then(d=>{dls=d;if(d)$('dl').textContent='Download STL (.zip)';else{$('dl').disabled=$('ed').disabled=true;$('dl').textContent='Download unavailable here'}}).catch(()=>{});
const nameBase=()=>(($('a').value+'-'+$('b').value).replace(/[^\p{L}\p{N}-]/gu,'')||'flip-name').slice(0,40);
const ready=()=>{if(S||(check()&&build()))return true;$('info').textContent='Enter both names first.';return false};
const anchor=(blob,name)=>{const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=name;a.click()};
async function saveBlob(name,blob){
  try{if(framed){if(dls)await dls.save({filename:name,data:blob})}else anchor(blob,name)}
  catch(e){if(e&&e.code!=='declined')$('info').textContent='Could not save: '+(e.message||e.code)}
}
$('dl').onclick=async()=>{
  if(!ready())return;const b=nameBase();
  if(framed)await saveBlob(b+'.zip',zipMany([{name:b+'.stl',data:stlBytes()}]));
  else anchor(new Blob([stlBytes()],{type:'model/stl'}),b+'.stl');
};
// Editable files for Tinkercad, Fusion 360, Blender, etc.
$('ed').onclick=async()=>{
  if(!ready())return;const b=nameBase(),te=new TextEncoder();
  const txt='Flip Name 3D - editable files\n\n'+b+'.obj : whole model (letters + base), import into Tinkercad, Fusion 360, Blender, etc.\n'+
    b+'-letters.stl and '+b+'-base.stl : separate parts, so you can edit or color them independently.\nUnits are millimetres, Z is up.\n\nTinkercad: Import > choose the .obj (or an .stl) > set the scale to 100% > Import.\n';
  await saveBlob(b+'-editable.zip',zipMany([{name:b+'.obj',data:te.encode(objText())},{name:b+'-letters.stl',data:stlOf(tri('L'))},{name:b+'-base.stl',data:stlOf(tri('P'))},{name:'README.txt',data:te.encode(txt)}]));
};
