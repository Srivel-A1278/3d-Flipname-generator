  S.base=LC.pos.slice();S.names=A.map((c,k)=>c+'/'+B[k]);S.slot=new Uint8Array(S.base.length/3);for(let v=0;v<S.slot.length;v++)S.slot[v]=Math.max(0,Math.min(n-1,Math.floor(S.base[3*v]/CW)));
