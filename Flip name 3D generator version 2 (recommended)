  const mk=(arr,mat)=>{const g=new THREE.BufferGeometry();g.setAttribute('position',new THREE.BufferAttribute(new Float32Array(arr),3));g.computeVertexNormals();
    const m=new THREE.Mesh(g,mat);m.castShadow=m.receiveShadow=true;m.position.set(-C,gy,-C);return m};
  const mkL=(m3,mat)=>{const g=new THREE.BufferGeometry();g.setAttribute('position',new THREE.BufferAttribute(new Float32Array(m3.pos),3));
    g.setIndex(new THREE.BufferAttribute(new Uint32Array(m3.idx),1));g.computeVertexNormals();
    const m=new THREE.Mesh(g,mat);m.castShadow=m.receiveShadow=true;m.position.set(-C,gy,-C);return m};
