function onTex(){$('txr').style.display=$('tx').value?'block':'none';$('tdv').textContent=(+$('td').value).toFixed(2);$('tfv').textContent=(+$('tf').value).toFixed(1);if(S)applyTex()}
$('tx').onchange=$('td').oninput=$('tf').oninput=onTex;
