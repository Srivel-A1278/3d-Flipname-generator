  b.onclick=()=>{const f=cur,st=f.selectionStart==null?f.value.length:f.selectionStart,en=f.selectionEnd==null?st:f.selectionEnd;
    f.value=f.value.slice(0,st)+e+f.value.slice(en);const q=st+e.length;try{f.setSelectionRange(q,q)}catch(x){}check()};
  $('eg').appendChild(b);
