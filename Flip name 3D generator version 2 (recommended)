$('a').oninput=$('b').oninput=check;
let cur=$('a');['a','b'].forEach(id=>$(id).addEventListener('focus',()=>cur=$(id)));
['❤️','💖','💕','💗','💙','💜','🧡','💛','💚','🖤','🤍','💝','⭐','🌟','✨','🌸','🌹','🌷','🌻','🌼','🍀','🌈','☀️','🌙','🔥','🎉','🎈','🎂','🏆','👑','💎','🎵','🐱','🐶','🦋','🐼','🦄','🐰','🏠','🚗','✈️','⚽','🎮','📚','☕','🍕','🍓','🍦'].forEach(e=>{
