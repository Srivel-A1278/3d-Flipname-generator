}
function check(){
  const a=chars($('a').value),b=chars($('b').value),w=$('warn');
  if(a.length===b.length||!a.length||!b.length){w.style.display='none';return true}
  const sh=a.length<b.length?'a':'b',df=Math.abs(a.length-b.length);
